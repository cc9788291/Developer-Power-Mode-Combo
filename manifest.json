{
  "manifest_version": 3,
  "name": "Developer Power Mode Combo",
  "version": "1.0.0",
  "description": "A local-only typing combo and pixel-pet overlay for ordinary web pages.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Developer Power Mode Combo",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
